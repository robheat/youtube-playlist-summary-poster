# Copy this file to .env for local runs. Never commit the real .env file.
# In GitHub Actions, these are set as repo Secrets/Variables instead (see README.md).

# --- Always required ---
YOUTUBE_API_KEY=
# cryptocatalyst-news or ainformed-dev -- selects the SiteProfile (playlist
# ID + category taxonomy) in app/config.py. Playlist IDs are NOT set here;
# they're baked into each SiteProfile.
TARGET_SITE=cryptocatalyst-news
# gemini or venice
SUMMARY_PROVIDER=gemini

# --- Required if SUMMARY_PROVIDER=gemini ---
GEMINI_API_KEY=
# optional, defaults to gemini-3.6-flash
GEMINI_MODEL=

# --- Required if SUMMARY_PROVIDER=venice ---
VENICE_AI_API_KEY=
# optional, defaults to mistral-small-3-2-24b-instruct
VENICE_MODEL=

# --- Optional: mitigates YouTube IP-blocking of transcript fetches (venice path only) ---
# Must be both set or both left blank. See README.md "Transcript IP blocking" section.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# --- Required unless running with --dry-run ---
# Fine-grained GitHub personal access token scoped to ONLY the
# cryptocatalyst-news and ainformed-dev repos, "Contents: Read and write".
# See README.md "Creating SITE_REPO_PAT".
SITE_REPO_PAT=

# --- Optional ---
# max videos to process in a single run, defaults to 5
MAX_VIDEOS_PER_RUN=
